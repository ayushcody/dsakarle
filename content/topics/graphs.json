  "overview": {
    "summary": "Graphs model relationships between objects. Unlike trees, graphs can have cycles, multiple parents, and disjoint sections.",
    "learningObjectives": [
      "Distinguish between directed/undirected and weighted/unweighted graphs.",
      "Represent graphs using Adjacency Lists and Adjacency Matrices.",
      "Traverse graphs using BFS and DFS while tracking visited nodes."
    ],
    "interviewRelevance": "Graphs are the pinnacle of interview data structures. Problems often disguise themselves as matrices, grids, or social networks."
  },
  "realWorldHook": {
    "paragraphs": [
      "The internet is a graph of web pages connected by hyperlinks. Facebook is a graph of people connected by friendships. Google Maps is a graph of intersections connected by roads.",
      "Anytime you need to find the shortest path, detect a cycle (like a deadlock), or see if two things are connected, you are using a graph algorithm."
    ],
    "ahaMoment": "A Tree is just a restricted Graph. If you remove the rules 'must have a root' and 'cannot have cycles', a Tree becomes a Graph."
  },
  "definition": {
    "technicalDefinition": "A Graph is a non-linear data structure consisting of nodes (vertices) and edges that connect pairs of nodes.",
    "vocabulary": [
      {
        "term": "Vertex / Node",
        "definition": "An entity in the graph."
      },
      {
        "term": "Edge",
        "definition": "A connection between two vertices."
      },
      {
        "term": "Directed Edge",
        "definition": "A one-way street (A -> B)."
      },
      {
        "term": "Undirected Edge",
        "definition": "A two-way street (A <-> B)."
      },
      {
        "term": "Cycle",
        "definition": "A path that starts and ends at the exact same vertex."
      }
    ],
    "keyProperties": [
      "Can be dense (many edges) or sparse (few edges).",
      "May contain isolated nodes with no edges.",
      "Requires a 'visited' set during traversal to prevent infinite loops."
    ]
  },
  "mentalModel": {
    "metaphor": [
      "A map of flight routes between cities. Some flights go both ways (Undirected), some only go one way (Directed), and some cost more money (Weighted)."
    ],
    "clickSentence": "Graphs don't have a clear 'starting point' like a Tree's Root. You can enter a Graph from any node.",
