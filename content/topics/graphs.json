  "structure": {
    "memoryDescription": [
      "Because nodes can connect to anywhere from 0 to N other nodes, storing a Graph is harder than a Tree.",
      "We usually use an Adjacency List: A Hash Map where the Key is a node, and the Value is an Array of its neighbors."
    ],
    "definitionCode": {
      "python": "adj_list = {\n  'A': ['B', 'C'],\n  'B': ['A', 'D'],\n  'C': ['A'],\n  'D': ['B']\n}",
      "javascript": "const adjList = new Map();\nadjList.set('A', ['B', 'C']);\nadjList.set('B', ['A', 'D']);",
      "java": "Map<String, List<String>> adjList = new HashMap<>();\nadjList.put(\"A\", Arrays.asList(\"B\", \"C\"));",
      "cpp": "unordered_map<string, vector<string>> adjList;\nadjList[\"A\"] = {\"B\", \"C\"};"
    },
