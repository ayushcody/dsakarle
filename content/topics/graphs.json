    "code": {
      "python": "def dfs(g, start):\n    stack, seen = [start], {start}\n    while stack:\n        u = stack.pop(); visit(u)\n        for v in reversed(g[u]):\n            if v not in seen: seen.add(v); stack.append(v)"
    },
