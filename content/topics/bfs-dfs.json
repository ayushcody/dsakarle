  "structure": {
    "memoryDescription": [
      "BFS requires O(W) memory for the Queue, where W is the maximum width of the graph.",
      "DFS requires O(H) memory for the Call Stack, where H is the maximum depth of the graph."
    ],
    "definitionCode": {
      "python": "# BFS Iterative\nfrom collections import deque\nq = deque([start])\nvisited = set([start])\nwhile q:\n    node = q.popleft() # Pop from FRONT\n    for neighbor in graph[node]:\n        if neighbor not in visited:\n            visited.add(neighbor)\n            q.append(neighbor) # Push to BACK",
      "javascript": "// DFS Recursive\nconst visited = new Set();\nfunction dfs(node) {\n    if (visited.has(node)) return;\n    visited.add(node);\n    for (let neighbor of graph[node]) {\n        dfs(neighbor);\n    }\n}"
    },
    "memoryLayout": [
      {
        "label": "BFS Queue",
        "value": "Front -> [Level 2 nodes] ... [Level 3 nodes] <- Back"
      },
      {
        "label": "DFS Stack",
        "value": "Top -> [Deepest node] ... [Root node] <- Bottom"
      }
    ]
  },
  "stepper": {
    "diagramType": "graph",
    "code": {
      "python": "def bfs(g, start):\n    q, seen = deque([start]), {start}\n    while q:\n        u = q.popleft(); visit(u)\n        for v in g[u]:\n            if v not in seen: seen.add(v); q.append(v)"
    },
