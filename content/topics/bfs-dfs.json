  "overview": {
    "summary": "Breadth-First Search (BFS) and Depth-First Search (DFS) are the two fundamental algorithms for traversing or searching tree and graph data structures.",
    "learningObjectives": [
      "Understand why BFS uses a Queue and DFS uses a Stack (or Recursion).",
      "Recognize when to use BFS (Shortest Path) vs DFS (Exhaustive Search).",
      "Correctly implement the 'visited' set to prevent infinite loops."
    ],
    "interviewRelevance": "More than 30% of all interview questions boil down to running BFS or DFS on a grid, tree, or graph."
  },
  "realWorldHook": {
    "paragraphs": [
      "Imagine you are stuck in the center of a corn maze and need to find the exit.",
      "DFS is putting your hand on the right wall and walking forward until you hit a dead end, then backing up. BFS is cloning yourself at every intersection and exploring every path simultaneously layer by layer."
    ],
    "ahaMoment": "BFS and DFS are exactly the same algorithm, except one uses a Queue (First In First Out) and the other uses a Stack (Last In First Out)."
  },
  "definition": {
    "technicalDefinition": "BFS explores the neighbor nodes first, before moving to the next level neighbors. DFS explores as far as possible along each branch before backtracking.",
    "vocabulary": [
      {
        "term": "Queue",
        "definition": "The data structure required for BFS. Ensures nodes discovered first are processed first."
      },
      {
        "term": "Stack / Call Stack",
        "definition": "The data structure required for DFS. Ensures the most recently discovered node is processed first."
      },
      {
        "term": "Visited Set",
        "definition": "A Hash Set used to track which nodes have already been processed to prevent infinite cycles."
      }
    ],
    "keyProperties": [
      "BFS guarantees the shortest path in an unweighted graph.",
      "DFS is easier to write because it uses recursion.",
      "Both traverse every reachable node in O(V + E) time."
    ]
  },
  "mentalModel": {
    "metaphor": [
      "BFS: A ripple in a pond. The water expands outward in perfect circles.",
      "DFS: A snake hunting. It slithers all the way down a tunnel, comes back out, and goes down the next tunnel."
    ],
    "clickSentence": "BFS goes WIDE. DFS goes DEEP.",
